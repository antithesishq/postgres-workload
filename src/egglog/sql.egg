;; Rewrite rules for SQL

;; ===========================================================================
;; Data types
;; ===========================================================================

(datatype Type
  (TyInteger)
  (TyString)
  (TyBoolean)
  (TyNullable Type))

(datatype FieldName
  (Unqualified String)
  (Qualified String String))

(datatype Field
  (AField FieldName Type))

(datatype Schema
  (SCons Field Schema)
  (SBase Field))

(datatype Expr
  (Ref FieldName)
  (Lit i64)
  (LitStr String)
  (LitBool bool)
  (Eq Expr Expr)
  (And Expr Expr)
  (Or Expr Expr)
  (Not Expr)
  (Add Expr Expr)
  (Sub Expr Expr)
  (IsNull Expr))

;; Aggregate functions
(datatype AggFunc
  (FSum Expr)
  (FCount)
  (FCountExpr Expr))

;; Named aggregate binding: assigns a column name to an aggregate computation
(datatype AggBinding
  (ABind FieldName AggFunc))

;; List of aggregate bindings
(datatype AggBindings
  (ABindCons AggBinding AggBindings)
  (ABindBase AggBinding))

(datatype Query
  (Relation String Schema)
  (Filter Query Expr)
  (Project Query Schema)
  (Extend Query Field Expr)
  (Join Query Query)
  (Qualify Query String)
  (Rename Query FieldName FieldName)
  (Distinct Query)
  (Union Query Query)
  (UnionAll Query Query)
  ;; Aggregate: input query, group-by key schema, aggregate bindings.
  ;; Output schema is group-by keys concatenated with aggregate result columns.
  (Aggregate Query Schema AggBindings))

;; We create two rulesets. One populates information about the current schemas
;; and the other performs rewrites.
(ruleset analysis)
(ruleset optimize)

;; ===========================================================================
;; Schema utility functions
;; ===========================================================================

(function schema-of (Query) Schema :no-merge)
(function schema-concat (Schema Schema) Schema :no-merge)
(function qualify-schema (Schema String) Schema :no-merge)
(function rename-schema (Schema FieldName FieldName) Schema :no-merge)

;; Demand relations
(relation need-schema-concat (Schema Schema))
(relation need-qualify-schema (Schema String))
(relation need-rename-schema (Schema FieldName FieldName))

;; schema-concat - combine two schemas (useful e.g. for Extend queries)

;; Base case: single field on the left, prepend to right
(rule ((need-schema-concat s1 s2)
       (= s1 (SBase f)))
      ((set (schema-concat s1 s2) (SCons f s2)))
      :ruleset analysis)

;; Recursive case: peel off head of left, demand the rest, then combine
(rule ((need-schema-concat s1 s2)
       (= s1 (SCons f rest)))
      ((need-schema-concat rest s2))
      :ruleset analysis)

(rule ((need-schema-concat s1 s2)
       (= s1 (SCons f rest))
       (= s (schema-concat rest s2)))
      ((set (schema-concat s1 s2) (SCons f s)))
      :ruleset analysis)

;; qualify-schema (perform aliasing)

;; Base, unqualified
(rule ((need-qualify-schema s a)
       (= s (SBase (AField (Unqualified name) ty))))
      ((set (qualify-schema s a)
            (SBase (AField (Qualified a name) ty))))
      :ruleset analysis)

;; Base, already qualified
(rule ((need-qualify-schema s a)
       (= s (SBase (AField (Qualified old name) ty))))
      ((set (qualify-schema s a)
            (SBase (AField (Qualified a name) ty))))
      :ruleset analysis)

;; Cons: demand the recursive call
(rule ((need-qualify-schema s a)
       (= s (SCons (AField fn ty) rest)))
      ((need-qualify-schema rest a))
      :ruleset analysis)

;; Cons, unqualified head + recursive result ready
(rule ((need-qualify-schema s a)
       (= s (SCons (AField (Unqualified name) ty) rest))
       (= qrest (qualify-schema rest a)))
      ((set (qualify-schema s a)
            (SCons (AField (Qualified a name) ty) qrest)))
      :ruleset analysis)

;; Cons, already qualified head + recursive result ready
(rule ((need-qualify-schema s a)
       (= s (SCons (AField (Qualified old name) ty) rest))
       (= qrest (qualify-schema rest a)))
      ((set (qualify-schema s a)
            (SCons (AField (Qualified a name) ty) qrest)))
      :ruleset analysis)

;; --- rename-schema ---

;; Base, match found
(rule ((need-rename-schema s old new)
       (= s (SBase (AField old ty))))
      ((set (rename-schema s old new)
            (SBase (AField new ty))))
      :ruleset analysis)

;; Base, no match
(rule ((need-rename-schema s old new)
       (= s (SBase (AField other ty)))
       (!= other old))
      ((set (rename-schema s old new) s))
      :ruleset analysis)

;; Cons head matches
(rule ((need-rename-schema s old new)
       (= s (SCons (AField old ty) rest)))
      ((set (rename-schema s old new)
            (SCons (AField new ty) rest)))
      :ruleset analysis)

;; Cons head doesn't match: demand recursive call
(rule ((need-rename-schema s old new)
       (= s (SCons (AField other ty) rest))
       (!= other old))
      ((need-rename-schema rest old new))
      :ruleset analysis)

;; Cons head doesn't match + recursive result ready
(rule ((need-rename-schema s old new)
       (= s (SCons (AField other ty) rest))
       (!= other old)
       (= rrest (rename-schema rest old new)))
      ((set (rename-schema s old new)
            (SCons (AField other ty) rrest)))
      :ruleset analysis)

;; ===========================================================================
;; Aggregate schema computation
;; ===========================================================================

(function agg-func-type (AggFunc) Type :no-merge)
(function agg-schema (AggBindings) Schema :no-merge)

;; Aggregate function result types
;; COUNT always returns a non-nullable integer (0 for empty groups)
(rule ((= f (FCount)))       ((set (agg-func-type f) (TyInteger)))               :ruleset analysis)
(rule ((= f (FCountExpr _))) ((set (agg-func-type f) (TyInteger)))               :ruleset analysis)
;; SUM returns nullable integer (NULL for empty groups)
(rule ((= f (FSum _)))       ((set (agg-func-type f) (TyNullable (TyInteger))))  :ruleset analysis)

;; agg-schema: derive the output schema from aggregate bindings
(rule ((= ab (ABindBase (ABind name func)))
       (= ty (agg-func-type func)))
      ((set (agg-schema ab) (SBase (AField name ty))))
      :ruleset analysis)

(rule ((= ab (ABindCons (ABind name func) rest))
       (= ty (agg-func-type func))
       (= rs (agg-schema rest)))
      ((set (agg-schema ab) (SCons (AField name ty) rs)))
      :ruleset analysis)

;; ===========================================================================
;; schema-of
;; ===========================================================================

(rule ((= q (Relation name s)))
      ((set (schema-of q) s))
      :ruleset analysis)

(rule ((= q (Filter inner pred))
       (= s (schema-of inner)))
      ((set (schema-of q) s))
      :ruleset analysis)

(rule ((= q (Project inner s)))
      ((set (schema-of q) s))
      :ruleset analysis)

(rule ((= q (Extend inner (AField name ty) expr))
       (= s (schema-of inner)))
      ((set (schema-of q) (SCons (AField name ty) s)))
      :ruleset analysis)

(rule ((= q (Distinct inner))
       (= s (schema-of inner)))
      ((set (schema-of q) s))
      :ruleset analysis)

;; Join: demand schema-concat, then set when ready
(rule ((= q (Join q1 q2))
       (= s1 (schema-of q1))
       (= s2 (schema-of q2)))
      ((need-schema-concat s1 s2))
      :ruleset analysis)

(rule ((= q (Join q1 q2))
       (= s1 (schema-of q1))
       (= s2 (schema-of q2))
       (= s (schema-concat s1 s2)))
      ((set (schema-of q) s))
      :ruleset analysis)

;; Qualify: demand qualify-schema, then set when ready
(rule ((= q (Qualify inner a))
       (= s (schema-of inner)))
      ((need-qualify-schema s a))
      :ruleset analysis)

(rule ((= q (Qualify inner a))
       (= s (schema-of inner))
       (= qs (qualify-schema s a)))
      ((set (schema-of q) qs))
      :ruleset analysis)

;; Rename: demand rename-schema, then set when ready
(rule ((= q (Rename inner old new))
       (= s (schema-of inner)))
      ((need-rename-schema s old new))
      :ruleset analysis)

(rule ((= q (Rename inner old new))
       (= s (schema-of inner))
       (= rs (rename-schema s old new)))
      ((set (schema-of q) rs))
      :ruleset analysis)

(rule ((= q (Union q1 q2))
       (= s (schema-of q1)))
      ((set (schema-of q) s))
      :ruleset analysis)

(rule ((= q (UnionAll q1 q2))
       (= s (schema-of q1)))
      ((set (schema-of q) s))
      :ruleset analysis)

;; Aggregate: output is group-by keys ++ aggregate result columns
(rule ((= q (Aggregate inner keys aggs))
       (= as (agg-schema aggs)))
      ((need-schema-concat keys as))
      :ruleset analysis)

(rule ((= q (Aggregate inner keys aggs))
       (= as (agg-schema aggs))
       (= s (schema-concat keys as)))
      ((set (schema-of q) s))
      :ruleset analysis)

;; ===========================================================================
;; field-in-schema & field-type-in-schema
;; ===========================================================================

(function field-in-schema (FieldName Schema) bool :no-merge)
(function field-type-in-schema (FieldName Schema) Type :no-merge)

;; field-in-schema

(rule ((= s (SBase (AField name ty))))
      ((set (field-in-schema name s) true))
      :ruleset analysis)
(rule ((= s (SCons (AField name ty) rest)))
      ((set (field-in-schema name s) true))
      :ruleset analysis)
(rule ((= s (SCons (AField hname ty) rest))
       (= true (field-in-schema name rest)))
      ((set (field-in-schema name s) true))
      :ruleset analysis)

;; field-type-in-schema: look up the type of a field in a schema

(rule ((= s (SBase (AField name ty))))
      ((set (field-type-in-schema name s) ty))
      :ruleset analysis)
(rule ((= s (SCons (AField name ty) rest)))
      ((set (field-type-in-schema name s) ty))
      :ruleset analysis)
(rule ((= s (SCons (AField hname hty) rest))
       (= ty (field-type-in-schema name rest)))
      ((set (field-type-in-schema name s) ty))
      :ruleset analysis)

;; ===========================================================================
;; Type helpers
;; ===========================================================================

(function is-nullable-type (Type) bool :no-merge)

(rule ((= t (TyNullable _)))  ((set (is-nullable-type t) true))  :ruleset analysis)
(rule ((= t (TyInteger)))     ((set (is-nullable-type t) false)) :ruleset analysis)
(rule ((= t (TyString)))      ((set (is-nullable-type t) false)) :ruleset analysis)
(rule ((= t (TyBoolean)))     ((set (is-nullable-type t) false)) :ruleset analysis)

;; Flatten nested nullable: TyNullable(TyNullable(X)) = TyNullable(X)
(rule ((= t (TyNullable (TyNullable inner))))
      ((union t (TyNullable inner)))
      :ruleset analysis)

;; ===========================================================================
;; Type inference: type-of-in (Expr Schema) -> Type
;;
;; Demand-driven: we only compute types for expressions in contexts where
;; type information is needed (e.g. Filter predicates, Extend expressions).
;; Nullability propagates through operators per SQL three-valued logic:
;; any operation on NULL produces NULL, except IsNull which always returns
;; a non-nullable boolean.
;; ===========================================================================

(function type-of-in (Expr Schema) Type :no-merge)
(relation need-type-of-in (Expr Schema))

;; Demand: Filter predicates
(rule ((= q (Filter inner pred))
       (= s (schema-of inner)))
      ((need-type-of-in pred s))
      :ruleset analysis)

;; Demand: Extend expressions
(rule ((= q (Extend inner (AField name ty) expr))
       (= s (schema-of inner)))
      ((need-type-of-in expr s))
      :ruleset analysis)

;; --- Literals (always non-nullable) ---

(rule ((need-type-of-in e s) (= e (Lit _)))
      ((set (type-of-in e s) (TyInteger)))
      :ruleset analysis)
(rule ((need-type-of-in e s) (= e (LitStr _)))
      ((set (type-of-in e s) (TyString)))
      :ruleset analysis)
(rule ((need-type-of-in e s) (= e (LitBool _)))
      ((set (type-of-in e s) (TyBoolean)))
      :ruleset analysis)

;; --- Ref: type comes from schema ---

(rule ((need-type-of-in e s) (= e (Ref name))
       (= ty (field-type-in-schema name s)))
      ((set (type-of-in e s) ty))
      :ruleset analysis)

;; --- IsNull: always returns non-nullable boolean ---

(rule ((need-type-of-in e s) (= e (IsNull e1)))
      ((need-type-of-in e1 s))
      :ruleset analysis)
(rule ((need-type-of-in e s) (= e (IsNull e1))
       (= _t (type-of-in e1 s)))
      ((set (type-of-in e s) (TyBoolean)))
      :ruleset analysis)

;; --- Not: boolean, nullable iff operand is nullable ---

(rule ((need-type-of-in e s) (= e (Not e1)))
      ((need-type-of-in e1 s))
      :ruleset analysis)
(rule ((need-type-of-in e s) (= e (Not e1))
       (= t1 (type-of-in e1 s)) (= false (is-nullable-type t1)))
      ((set (type-of-in e s) (TyBoolean)))
      :ruleset analysis)
(rule ((need-type-of-in e s) (= e (Not e1))
       (= t1 (type-of-in e1 s)) (= true (is-nullable-type t1)))
      ((set (type-of-in e s) (TyNullable (TyBoolean))))
      :ruleset analysis)

;; --- And: boolean, nullable if either operand is nullable ---

(rule ((need-type-of-in e s) (= e (And e1 e2)))
      ((need-type-of-in e1 s) (need-type-of-in e2 s))
      :ruleset analysis)
(rule ((need-type-of-in e s) (= e (And e1 e2))
       (= t1 (type-of-in e1 s)) (= false (is-nullable-type t1))
       (= t2 (type-of-in e2 s)) (= false (is-nullable-type t2)))
      ((set (type-of-in e s) (TyBoolean)))
      :ruleset analysis)
(rule ((need-type-of-in e s) (= e (And e1 e2))
       (= t1 (type-of-in e1 s)) (= true (is-nullable-type t1)))
      ((set (type-of-in e s) (TyNullable (TyBoolean))))
      :ruleset analysis)
(rule ((need-type-of-in e s) (= e (And e1 e2))
       (= t2 (type-of-in e2 s)) (= true (is-nullable-type t2)))
      ((set (type-of-in e s) (TyNullable (TyBoolean))))
      :ruleset analysis)

;; --- Or: boolean, nullable if either operand is nullable ---

(rule ((need-type-of-in e s) (= e (Or e1 e2)))
      ((need-type-of-in e1 s) (need-type-of-in e2 s))
      :ruleset analysis)
(rule ((need-type-of-in e s) (= e (Or e1 e2))
       (= t1 (type-of-in e1 s)) (= false (is-nullable-type t1))
       (= t2 (type-of-in e2 s)) (= false (is-nullable-type t2)))
      ((set (type-of-in e s) (TyBoolean)))
      :ruleset analysis)
(rule ((need-type-of-in e s) (= e (Or e1 e2))
       (= t1 (type-of-in e1 s)) (= true (is-nullable-type t1)))
      ((set (type-of-in e s) (TyNullable (TyBoolean))))
      :ruleset analysis)
(rule ((need-type-of-in e s) (= e (Or e1 e2))
       (= t2 (type-of-in e2 s)) (= true (is-nullable-type t2)))
      ((set (type-of-in e s) (TyNullable (TyBoolean))))
      :ruleset analysis)

;; --- Eq: boolean, nullable if either operand is nullable ---

(rule ((need-type-of-in e s) (= e (Eq e1 e2)))
      ((need-type-of-in e1 s) (need-type-of-in e2 s))
      :ruleset analysis)
(rule ((need-type-of-in e s) (= e (Eq e1 e2))
       (= t1 (type-of-in e1 s)) (= false (is-nullable-type t1))
       (= t2 (type-of-in e2 s)) (= false (is-nullable-type t2)))
      ((set (type-of-in e s) (TyBoolean)))
      :ruleset analysis)
(rule ((need-type-of-in e s) (= e (Eq e1 e2))
       (= t1 (type-of-in e1 s)) (= true (is-nullable-type t1)))
      ((set (type-of-in e s) (TyNullable (TyBoolean))))
      :ruleset analysis)
(rule ((need-type-of-in e s) (= e (Eq e1 e2))
       (= t2 (type-of-in e2 s)) (= true (is-nullable-type t2)))
      ((set (type-of-in e s) (TyNullable (TyBoolean))))
      :ruleset analysis)

;; --- Add: integer, nullable if either operand is nullable ---

(rule ((need-type-of-in e s) (= e (Add e1 e2)))
      ((need-type-of-in e1 s) (need-type-of-in e2 s))
      :ruleset analysis)
(rule ((need-type-of-in e s) (= e (Add e1 e2))
       (= t1 (type-of-in e1 s)) (= false (is-nullable-type t1))
       (= t2 (type-of-in e2 s)) (= false (is-nullable-type t2)))
      ((set (type-of-in e s) (TyInteger)))
      :ruleset analysis)
(rule ((need-type-of-in e s) (= e (Add e1 e2))
       (= t1 (type-of-in e1 s)) (= true (is-nullable-type t1)))
      ((set (type-of-in e s) (TyNullable (TyInteger))))
      :ruleset analysis)
(rule ((need-type-of-in e s) (= e (Add e1 e2))
       (= t2 (type-of-in e2 s)) (= true (is-nullable-type t2)))
      ((set (type-of-in e s) (TyNullable (TyInteger))))
      :ruleset analysis)

;; --- Sub: integer, nullable if either operand is nullable ---

(rule ((need-type-of-in e s) (= e (Sub e1 e2)))
      ((need-type-of-in e1 s) (need-type-of-in e2 s))
      :ruleset analysis)
(rule ((need-type-of-in e s) (= e (Sub e1 e2))
       (= t1 (type-of-in e1 s)) (= false (is-nullable-type t1))
       (= t2 (type-of-in e2 s)) (= false (is-nullable-type t2)))
      ((set (type-of-in e s) (TyInteger)))
      :ruleset analysis)
(rule ((need-type-of-in e s) (= e (Sub e1 e2))
       (= t1 (type-of-in e1 s)) (= true (is-nullable-type t1)))
      ((set (type-of-in e s) (TyNullable (TyInteger))))
      :ruleset analysis)
(rule ((need-type-of-in e s) (= e (Sub e1 e2))
       (= t2 (type-of-in e2 s)) (= true (is-nullable-type t2)))
      ((set (type-of-in e s) (TyNullable (TyInteger))))
      :ruleset analysis)

;; ===========================================================================
;; fields-subset
;;
;; Tells us whether an Expr's free variables are all contained in a Schema.
;; ===========================================================================

(function fields-subset (Expr Schema) bool :no-merge)
(relation need-fields-subset (Expr Schema))

;; Demand: Filter on Join
(rule ((= fq (Filter (Join q1 q2) pred))
       (= s1 (schema-of q1)))
      ((need-fields-subset pred s1))
      :ruleset analysis)
(rule ((= fq (Filter (Join q1 q2) pred))
       (= s2 (schema-of q2)))
      ((need-fields-subset pred s2))
      :ruleset analysis)

;; Demand: Filter on Join with conjunctive predicates
(rule ((= fq (Filter (Join q1 q2) pred))
       (= pred (And e1 e2))
       (= s1 (schema-of q1)))
      ((need-fields-subset e1 s1)
       (need-fields-subset e2 s1))
      :ruleset analysis)
(rule ((= fq (Filter (Join q1 q2) pred))
       (= pred (And e1 e2))
       (= s2 (schema-of q2)))
      ((need-fields-subset e1 s2)
       (need-fields-subset e2 s2))
      :ruleset analysis)

;; Demand: Filter on Aggregate (for HAVING -> WHERE pushdown)
(rule ((= q (Filter (Aggregate inner keys aggs) pred)))
      ((need-fields-subset pred keys))
      :ruleset analysis)
(rule ((= q (Filter (Aggregate inner keys aggs) pred))
       (= pred (And e1 e2)))
      ((need-fields-subset e1 keys)
       (need-fields-subset e2 keys))
      :ruleset analysis)

;; Demand: Aggregate over Filter (for WHERE -> HAVING pull-up)
(rule ((= q (Aggregate (Filter inner pred) keys aggs)))
      ((need-fields-subset pred keys))
      :ruleset analysis)
(rule ((= q (Aggregate (Filter inner pred) keys aggs))
       (= pred (And e1 e2)))
      ((need-fields-subset e1 keys)
       (need-fields-subset e2 keys))
      :ruleset analysis)

;; Literals are always valid
(rule ((need-fields-subset e s)
       (= e (Lit _)))
      ((set (fields-subset e s) true))
      :ruleset analysis)
(rule ((need-fields-subset e s)
       (= e (LitStr _)))
      ((set (fields-subset e s) true))
      :ruleset analysis)
(rule ((need-fields-subset e s)
       (= e (LitBool _)))
      ((set (fields-subset e s) true))
      :ruleset analysis)

;; Ref: valid if field is in schema
(rule ((need-fields-subset e s)
       (= e (Ref name))
       (= true (field-in-schema name s)))
      ((set (fields-subset e s) true))
      :ruleset analysis)

;; IsNull
(rule ((need-fields-subset e s) (= e (IsNull e1)))
      ((need-fields-subset e1 s))
      :ruleset analysis)
(rule ((need-fields-subset e s) (= e (IsNull e1))
       (= true (fields-subset e1 s)))
      ((set (fields-subset e s) true))
      :ruleset analysis)

;; Compound expressions: propagate demand to sub-expressions
(rule ((need-fields-subset e s) (= e (Eq e1 e2)))
      ((need-fields-subset e1 s) (need-fields-subset e2 s))
      :ruleset analysis)
(rule ((need-fields-subset e s) (= e (And e1 e2)))
      ((need-fields-subset e1 s) (need-fields-subset e2 s))
      :ruleset analysis)
(rule ((need-fields-subset e s) (= e (Or e1 e2)))
      ((need-fields-subset e1 s) (need-fields-subset e2 s))
      :ruleset analysis)
(rule ((need-fields-subset e s) (= e (Not e1)))
      ((need-fields-subset e1 s))
      :ruleset analysis)
(rule ((need-fields-subset e s) (= e (Add e1 e2)))
      ((need-fields-subset e1 s) (need-fields-subset e2 s))
      :ruleset analysis)
(rule ((need-fields-subset e s) (= e (Sub e1 e2)))
      ((need-fields-subset e1 s) (need-fields-subset e2 s))
      :ruleset analysis)

;; Combine results for compound expressions
(rule ((need-fields-subset e s) (= e (Eq e1 e2))
       (= true (fields-subset e1 s)) (= true (fields-subset e2 s)))
      ((set (fields-subset e s) true))
      :ruleset analysis)
(rule ((need-fields-subset e s) (= e (And e1 e2))
       (= true (fields-subset e1 s)) (= true (fields-subset e2 s)))
      ((set (fields-subset e s) true))
      :ruleset analysis)
(rule ((need-fields-subset e s) (= e (Or e1 e2))
       (= true (fields-subset e1 s)) (= true (fields-subset e2 s)))
      ((set (fields-subset e s) true))
      :ruleset analysis)
(rule ((need-fields-subset e s) (= e (Not e1))
       (= true (fields-subset e1 s)))
      ((set (fields-subset e s) true))
      :ruleset analysis)
(rule ((need-fields-subset e s) (= e (Add e1 e2))
       (= true (fields-subset e1 s)) (= true (fields-subset e2 s)))
      ((set (fields-subset e s) true))
      :ruleset analysis)
(rule ((need-fields-subset e s) (= e (Sub e1 e2))
       (= true (fields-subset e1 s)) (= true (fields-subset e2 s)))
      ((set (fields-subset e s) true))
      :ruleset analysis)

;; ===========================================================================
;; Expression classification (is-expr, is-bool-expr)
;; ===========================================================================

(function is-expr (Expr) bool :no-merge)

(rule ((= e (Ref _)))     ((set (is-expr e) true)) :ruleset analysis)
(rule ((= e (Lit _)))     ((set (is-expr e) true)) :ruleset analysis)
(rule ((= e (LitStr _)))  ((set (is-expr e) true)) :ruleset analysis)
(rule ((= e (LitBool _))) ((set (is-expr e) true)) :ruleset analysis)
(rule ((= e (Eq _ _)))    ((set (is-expr e) true)) :ruleset analysis)
(rule ((= e (And _ _)))   ((set (is-expr e) true)) :ruleset analysis)
(rule ((= e (Or _ _)))    ((set (is-expr e) true)) :ruleset analysis)
(rule ((= e (Not _)))     ((set (is-expr e) true)) :ruleset analysis)
(rule ((= e (Add _ _)))   ((set (is-expr e) true)) :ruleset analysis)
(rule ((= e (Sub _ _)))   ((set (is-expr e) true)) :ruleset analysis)
(rule ((= e (IsNull _)))  ((set (is-expr e) true)) :ruleset analysis)

(function is-bool-expr (Expr) bool :no-merge)

;; Structural: these expression forms always produce boolean results
(rule ((= e (LitBool _))) ((set (is-bool-expr e) true)) :ruleset analysis)
(rule ((= e (Eq _ _)))    ((set (is-bool-expr e) true)) :ruleset analysis)
(rule ((= e (And _ _)))   ((set (is-bool-expr e) true)) :ruleset analysis)
(rule ((= e (Or _ _)))    ((set (is-bool-expr e) true)) :ruleset analysis)
(rule ((= e (Not _)))     ((set (is-bool-expr e) true)) :ruleset analysis)
(rule ((= e (IsNull _)))  ((set (is-bool-expr e) true)) :ruleset analysis)

;; Type-informed: a Ref is boolean when its schema type is boolean (or nullable boolean)
(rule ((= ty (field-type-in-schema name s))
       (= ty (TyBoolean)))
      ((set (is-bool-expr (Ref name)) true))
      :ruleset analysis)
(rule ((= ty (field-type-in-schema name s))
       (= ty (TyNullable (TyBoolean))))
      ((set (is-bool-expr (Ref name)) true))
      :ruleset analysis)

;; ===========================================================================
;; Expression optimization rules
;; ===========================================================================

;; --- Boolean expression logic ----

;; Commutative properties
(rule ((= e (And e1 e2)))
      ((union e (And e2 e1))) :ruleset optimize)

(rule ((= e (Or e1 e2)))
      ((union e (Or e2 e1))) :ruleset optimize)

(rule ((= e (Eq e1 e2)))
      ((union e (Eq e2 e1))) :ruleset optimize)

;; Idempotence of And with true
(rule ((= e (And e1 (LitBool true))))
      ((union e e1)) :ruleset optimize)
(rule ((= e (And (LitBool true) e1)))
      ((union e e1)) :ruleset optimize)

(rule ((= true (is-bool-expr e)))
      ((union e (And e (LitBool true)))) :ruleset optimize)
(rule ((= true (is-bool-expr e)))
      ((union e (And (LitBool true) e))) :ruleset optimize)

;; And with false is always false
(rule ((= e (And e1 (LitBool false))))
      ((union e (LitBool false))) :ruleset optimize)
(rule ((= e (And (LitBool false) e1)))
      ((union e (LitBool false))) :ruleset optimize)

;; Idempotence of Or with false
(rule ((= e (Or e1 (LitBool false))))
      ((union e e1)) :ruleset optimize)
(rule ((= e (Or (LitBool false) e1)))
      ((union e e1)) :ruleset optimize)

(rule ((= true (is-bool-expr e)))
      ((union e (Or e (LitBool false)))) :ruleset optimize)
(rule ((= true (is-bool-expr e)))
      ((union e (Or (LitBool false) e))) :ruleset optimize)

;; Or with true is always true
(rule ((= e (Or e1 (LitBool true))))
      ((union e (LitBool true))) :ruleset optimize)
(rule ((= e (Or (LitBool true) e1)))
      ((union e (LitBool true))) :ruleset optimize)

;; Not of boolean literals
(rule ((= e (Not (LitBool true))))
      ((union e (LitBool false))) :ruleset optimize)
(rule ((= e (Not (LitBool false))))
      ((union e (LitBool true))) :ruleset optimize)

;; --- IsNull ---

;; Literals are never null
(rule ((= e (IsNull (Lit _))))
      ((union e (LitBool false))) :ruleset optimize)

(rule ((= e (IsNull (LitStr _))))
      ((union e (LitBool false))) :ruleset optimize)

(rule ((= e (IsNull (LitBool _))))
      ((union e (LitBool false))) :ruleset optimize)

;; IsNull of IsNull is always false (IsNull always returns true/false, never null)
(rule ((= e (IsNull (IsNull _))))
      ((union e (LitBool false))) :ruleset optimize)

;; NOTE: We intentionally do NOT include the rule
;;   "IsNull of a non-nullable column is false"
;; i.e. Filter(inner, IsNull(Ref(non_nullable))) = Filter(inner, false).
;; While semantically correct in the local schema context, expressing it as
;;   (union q (Filter inner (LitBool false)))
;; causes egglog's constructor congruence to GLOBALLY merge
;;   IsNull(Ref(name))  ≡  LitBool(false)
;; across the entire e-graph.  This poisons `fields-subset`: the merged
;; e-class now satisfies fields-subset(_, any_schema), which lets the
;; WHERE→HAVING pull-up rule fire for predicates referencing columns that
;; are NOT in the aggregate's group-by keys, producing queries that
;; reference columns outside their scope (e.g. "c0" above a GROUP BY "c5").

;; Filter by literal true is identity
(rule ((= q (Filter inner (LitBool true))))
      ((union q inner))
      :ruleset optimize)

;; Double negation
(rule ((= e (Not (Not e1))))
      ((union e e1)) :ruleset optimize)

;; IsNull interaction with Not: IsNull(NOT p) = IsNull(p)
;; (NOT NULL = NULL, so nullness is preserved through NOT)
(rule ((= e (IsNull (Not inner))))
      ((union e (IsNull inner))) :ruleset optimize)

;; ===========================================================================
;; Query optimization rules
;; ===========================================================================

;; Split conjunctive filters
(rule ((= q (Filter inner (And e1 e2))))
      ((union q (Filter (Filter inner e1) e2)))
      :ruleset optimize)

;; --- Predicate pushdown past join ----

;; Pushdown filter past join to LHS
(rule ((= q (Filter (Join q1 q2) pred))
       (= true (fields-subset pred (schema-of q1))))
      ((union q (Join (Filter q1 pred) q2)))
      :ruleset optimize)

;; Pushdown filter past join to RHS
(rule ((= q (Filter (Join q1 q2) pred))
       (= true (fields-subset pred (schema-of q2))))
      ((union q (Join q1 (Filter q2 pred))))
      :ruleset optimize)

;; Pull filter up from LHS of join
(rule ((= q (Join (Filter q1 pred) q2)))
      ((union q (Filter (Join q1 q2) pred)))
      :ruleset optimize)

;; Pull filter up from RHS of join
(rule ((= q (Join q1 (Filter q2 pred))))
      ((union q (Filter (Join q1 q2) pred)))
      :ruleset optimize)

;; ===========================================================================
;; Aggregation optimization rules
;; ===========================================================================

;; HAVING -> WHERE: push filter below aggregate when predicate only uses
;; group-by columns (not aggregate results). This is safe because the
;; predicate can be evaluated on individual rows before grouping, and
;; filtering rows by a group-by column before vs. after aggregation
;; yields the same groups with the same aggregate values.
(rule ((= q (Filter (Aggregate inner keys aggs) pred))
       (= true (fields-subset pred keys)))
      ((union q (Aggregate (Filter inner pred) keys aggs)))
      :ruleset optimize)

;; WHERE -> HAVING: pull filter above aggregate when predicate only uses
;; group-by columns. The reverse direction for e-graph exploration;
;; the cost model picks the better form.
(rule ((= q (Aggregate (Filter inner pred) keys aggs))
       (= true (fields-subset pred keys)))
      ((union q (Filter (Aggregate inner keys aggs) pred)))
      :ruleset optimize)

;; Distinct elimination above Aggregate: GROUP BY already produces unique
;; combinations of group-by columns, so Distinct is redundant.
(rule ((= q (Distinct (Aggregate inner keys aggs))))
      ((union q (Aggregate inner keys aggs)))
      :ruleset optimize)

;; ===========================================================================
;; TLP (Ternary Logic Partitioning)
;; https://www.manuelrigger.at/preprints/TLP.pdf
;;
;; For any Filter(R, p):
;;   R = Filter(R,p) UNION ALL Filter(R, NOT p) UNION ALL Filter(R, IsNull(p))
;; ===========================================================================

(rule ((= q (Filter inner pred))
       (= s (schema-of inner)))
      ((union inner
              (UnionAll (UnionAll (Filter inner pred)
                                  (Filter inner (Not pred)))
                        (Filter inner (IsNull pred)))))
      :ruleset optimize)
